  <diagram id="zit_7BEyq_KUFwFEUQPW" name="Assess Competition">
    <mxGraphModel dx="1434" dy="836" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d3KAuSrTWqHA7PjFqdNT-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="140" y="80" width="1022" height="588.56" as="geometry" />
        </mxCell>
        <mxCell id="3GOoNuSkPZ8NMLXZIPlM-1" value="&lt;p style=&quot;margin-bottom: 7.5pt; line-height: normal; background: white;&quot; class=&quot;MsoNormal&quot;&gt;&lt;/p&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;p style=&quot;margin-bottom:7.5pt;line-height:normal;mso-outline-level:&lt;br/&gt;3;background:white&quot; class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;font-family: Helvetica, sans-serif; color: rgb(51, 51, 51);&quot;&gt;&lt;font&gt;About the competitor analysis&lt;br/&gt;template&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;br/&gt;&lt;br/&gt;&lt;p style=&quot;margin-bottom:12.0pt;line-height:normal;background:&lt;br/&gt;white&quot; class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;font-family: Inter, serif; color: rgb(51, 51, 51);&quot;&gt;&lt;font&gt;You cannot&lt;br/&gt;assume that your product is the best on the market — you need to plan for it to&lt;br/&gt;be. Competitive analysis allows you to gauge what the rest of the market is&lt;br/&gt;doing and set strategies to better address the needs of your customers.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;br/&gt;&lt;br/&gt;&lt;p style=&quot;margin-bottom:12.0pt;line-height:normal;background:&lt;br/&gt;white&quot; class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;font-family: Inter, serif; color: rgb(51, 51, 51);&quot;&gt;&lt;font&gt;You need an&lt;br/&gt;approach that makes it easy to highlight observations — without having to track&lt;br/&gt;your competitors&#39; every move. This streamlined template helps you do just that.&lt;br/&gt;Use it to collect key information about your competitors: their mission&lt;br/&gt;statements, pricing models, top features, strengths, weaknesses, and&lt;br/&gt;differentiators.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;br/&gt;&lt;br/&gt;&lt;p style=&quot;margin-bottom:12.0pt;line-height:normal;background:&lt;br/&gt;white&quot; class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;font-family: Inter, serif; color: rgb(51, 51, 51);&quot;&gt;&lt;font&gt;Focus on&lt;br/&gt;gathering details that will help you answer: How do our products and services&lt;br/&gt;compare to the alternatives? And how can we better differentiate what we offer?&lt;br/&gt;Then, discuss opportunities as a team and use the insights you have gathered to&lt;br/&gt;provide unique value to your customers and deliver a product that truly&lt;br/&gt;delights them.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;br/&gt;&lt;br/&gt;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;font&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="120" width="500" height="570" as="geometry" />
        </mxCell>
        <mxCell id="6AsnVkfhDWJkjxjKpxlp-1" value="&lt;h4 style=&quot;box-sizing: border-box; margin: 0px 0px 8px; line-height: 1.5; font-family: &amp;quot;Public Sans&amp;quot;, sans-serif; color: rgb(33, 43, 54); text-align: start; background-color: rgb(255, 255, 255);&quot; class=&quot;MuiTypography-root MuiTypography-h4 MuiTypography-gutterBottom css-50exmm-MuiTypography-root&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Assess Competition&lt;/font&gt;&lt;/h4&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="495" y="50" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ullUy_8OzfoV64gU_u1a-1" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Product Strategy&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="500" y="20" width="170" height="30" as="geometry" />
